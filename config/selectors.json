{
  "_comment": "Candidate locators for the Amazon Ads console, tried in order until one becomes visible. Amazon changes this DOM without notice: when a run fails naming a key, add the new selector at the TOP of that list rather than editing the code. Any Playwright selector engine works: css, xpath=, text=, role=. '{report_name}' is replaced with this run's report name and '{value}' with the dropdown value being set (quote-escaped).",
  "_note_signin": "The sign-in, OTP and CAPTCHA entries are carried over from the out-of-budget-us project, where they were verified against the live Amazon sign-in pages (2026-09-18/19). They are shared by all Amazon Ads console pages.",
  "sign_in_marker": [
    "form[name='signIn']",
    "#ap_email",
    "#ap_password",
    "input[name='email'][type='email']",
    "text=/Sign in to continue/i"
  ],
  "security_challenge_marker": [
    "form[action*='validateCaptcha']",
    "#auth-mfa-otpcode",
    "input[name='otpCode']",
    "img[alt*='captcha' i]",
    "text=/Enter the characters you see/i",
    "text=/Two-Step Verification/i"
  ],
  "signin_email_input": [
    "#ap_email_login",
    "#ap_email",
    "input[type='email'][name='email']",
    "input[name='email']"
  ],
  "signin_continue_button": [
    "#continue",
    "input#continue",
    "input.a-button-input[type='submit']",
    "#continue-announce",
    "role=button[name=/^continue$/i]"
  ],
  "signin_password_input": [
    "#ap_password",
    "input[type='password'][name='password']",
    "input[name='password']"
  ],
  "signin_submit_button": [
    "#signInSubmit",
    "input#signInSubmit",
    "role=button[name=/^sign in$/i]"
  ],
  "signin_remember_me": [
    "input[name='rememberMe']",
    "#rememberMe"
  ],
  "signin_error_message": [
    "#auth-error-message-box",
    "div.a-alert-error .a-alert-content",
    "[role='alert'] .a-alert-content"
  ],
  "otp_input": [
    "#auth-mfa-otpcode",
    "input[name='otpCode']",
    "input[type='tel'][name*='otp' i]"
  ],
  "otp_remember_device": [
    "#auth-mfa-remember-device",
    "input[name='rememberDevice']"
  ],
  "otp_submit_button": [
    "#auth-signin-button",
    "input[name='mfaSubmit']",
    "input#auth-signin-button"
  ],
  "captcha_marker": [
    "form[action*='validateCaptcha']",
    "#auth-captcha-image",
    "img[alt*='captcha' i]",
    "text=/Enter the characters you see/i"
  ],
  "loading_indicator": [
    ".ag-overlay-loading-wrapper",
    "[data-testid='storm-ui-icon-spinner']",
    "[data-testid='skeleton']",
    "[role='progressbar']",
    "[aria-busy='true']"
  ],
  "_note_console": "Verified 2026-11-23 against the live Sponsored ads report center (advertising.amazon.com/reports, US). The list is an AG Grid with NO Download: each row links the report name to /reports/history/<id>, whose own grid lists the runs (Status / Last run / Report period / Recipients / Action). On Create report, Report category, Report type and Report period are dropdown BUTTONS that show the current value; clicking one that is already right opens a menu that blocks later clicks, so 'current' is checked first. NOTE: Amazon is retiring this report center (no new reports from 2026-12-17, closed 2027-01-31).",
  "reports_page_marker": [
    "role=button[name=/^create report$/i]",
    "role=grid",
    ".ag-root"
  ],
  "create_report_button": [
    "role=button[name=/^create report$/i]",
    "role=link[name=/^create report$/i]"
  ],
  "report_search_input": [
    "input[type='search']",
    "input[placeholder*='Search' i]",
    "role=searchbox"
  ],
  "report_builder_marker": [
    "role=textbox[name=/report name/i]",
    "text=/^Report category$/",
    "role=button[name=/^run report$/i]"
  ],
  "report_category_current": [
    "xpath=//*[normalize-space(text())='Report category']/following::button[normalize-space(.)='{value}'][1]",
    "button:text-is('{value}')"
  ],
  "report_category_trigger": [
    "xpath=//*[normalize-space(text())='Report category']/following::button[not(contains(normalize-space(.), 'availability'))][1]"
  ],
  "report_category_option": [
    "role=option[name='{value}' s]",
    "role=menuitem[name='{value}' s]",
    "role=menuitemradio[name='{value}' s]",
    "li:text-is('{value}')",
    "[role=listbox] :text-is('{value}')",
    "[role=menu] :text-is('{value}')"
  ],
  "report_type_current": [
    "xpath=//*[normalize-space(text())='Report type']/following::button[normalize-space(.)='{value}'][1]",
    "button:text-is('{value}')"
  ],
  "report_type_trigger": [
    "xpath=//*[normalize-space(text())='Report type']/following::button[1]"
  ],
  "report_type_option": [
    "role=option[name='{value}' s]",
    "role=menuitem[name='{value}' s]",
    "role=menuitemradio[name='{value}' s]",
    "li:text-is('{value}')",
    "[role=listbox] :text-is('{value}')",
    "[role=menu] :text-is('{value}')",
    "button:text-is('{value}')"
  ],
  "time_unit_daily": [
    "role=radio[name='Daily' s]",
    "input[type='radio'][value='DAILY' i]"
  ],
  "report_period_current": [
    "button[aria-label='Report period' i]:has-text('{value}')",
    "xpath=//*[normalize-space(text())='Report period']/following::button[1][contains(normalize-space(.), '{value}')]"
  ],
  "report_period_trigger": [
    "role=button[name=/^report period$/i]",
    "xpath=//*[normalize-space(text())='Report period']/following::button[1]"
  ],
  "report_period_option": [
    "role=option[name='{value}' s]",
    "role=menuitem[name='{value}' s]",
    "role=radio[name='{value}' s]",
    "li:text-is('{value}')",
    "button:text-is('{value}')",
    "label:text-is('{value}')"
  ],
  "report_name_input": [
    "role=textbox[name=/^enter a report name$/i]",
    "role=textbox[name=/report name/i]"
  ],
  "run_report_button": [
    "role=button[name=/^run report$/i]",
    "button:has-text('Run report')"
  ],
  "report_link": [
    "role=link[name='{report_name}' s]",
    "a:text-is('{report_name}')"
  ],
  "report_history_marker": [
    "role=heading[name=/^Report:/]",
    "role=grid"
  ],
  "_note_download": "Verified 2026-11-23: a finished run shows Status 'Completed' and, in the Action column, a link 'Download' to /reports/subscriptions/<report>/download-report/<run>. Amazon took ~35 minutes to finish the run.",
  "run_download_control": [
    "[role=grid] >> role=link[name=/download/i]",
    "[role=grid] >> role=button[name=/download/i]",
    "[role=grid] a[href*='download' i]",
    "[role=grid] a[download]"
  ]
}
