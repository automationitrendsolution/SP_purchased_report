# ---------------------------------------------------------------------------
# Sponsored Products "Purchased product" report pipeline
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored and must never be committed. Exported environment
# variables win over .env, so the same checkout works with systemd/secrets.
# ---------------------------------------------------------------------------

# --- Amazon Ads ------------------------------------------------------------
# Reports page: each run starts here, clicks Create report, fills in
# Sponsored Products > Purchased product > Daily and clicks Run report, then
# waits on the new report's own page until it can be downloaded.
AMAZON_REPORTS_URL=https://advertising.amazon.com/reports?entityId=ENTITY1A2B3C4D5E6F
# Fallback only: opened directly if the Create report button is not found.
AMAZON_NEW_REPORT_URL=https://advertising.amazon.com/reports/new?entityId=ENTITY1A2B3C4D5E6F
# Advertiser entity (must match the entityId in the URLs above). Optional when
# a URL above already carries entityId=...
AMAZON_ENTITY_ID=ENTITY1A2B3C4D5E6F
# Each run's report is named "<prefix> <UTC timestamp>" so it can be found again.
AMAZON_REPORT_NAME_PREFIX=SP Purchased product auto
# Optional Report period, exactly as the console shows it (e.g. Last 30 days).
# Leave unset to keep Amazon's default.
# AMAZON_REPORT_PERIOD=Last 30 days
# Keep reloading the report's page for up to this long, every N seconds.
# (Amazon took ~35 minutes to generate the report on 2026-11-23.)
REPORT_READY_TIMEOUT_MS=3600000
REPORT_POLL_SECONDS=60

# Sign-in credentials, used only when the saved browser session has expired.
# Set both or neither. A CAPTCHA or OTP prompt is never answered by a
# scheduled run: it stops with exit code 3 and waits for `run.py --login`.
AMAZON_EMAIL=you@example.com
AMAZON_PASSWORD=change-me
AMAZON_AUTO_LOGIN=true

# --- MySQL -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gen_ai_db
DB_USER=change-me
DB_PASSWORD=change-me
DB_TABLE=sponsored_products_purchased_product_report

# Create the table only if it is entirely absent. An existing table is never altered.
CREATE_TABLES=false

# Only when several brands/accounts share the table AND it has a brand_code
# column: every row is stamped with it and the delete is narrowed to it.
# BRAND_CODE=your_brand

# TLS. Point DB_SSL_CA at a CA bundle when the server requires one.
# DB_SSL_CA=certs/ca.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_DISABLED=false
DB_CONNECT_TIMEOUT_SECONDS=30

# --- Paths (relative paths resolve against the project root) ---------------
DOWNLOAD_DIR=data/downloads
PROCESSED_DIR=data/processed
FAILED_DIR=data/failed
SCREENSHOT_DIR=data/screenshots
LOG_DIR=logs
# Chromium profile holding the authenticated Amazon session. Treat as a secret.
SESSION_DIR=data/session
LOCK_FILE=data/pipeline.lock
HEADING_MAP_FILE=config/Purchased_Product_Heading.csv

# --- Browser ---------------------------------------------------------------
HEADLESS=true
BROWSER_TIMEOUT_MS=60000
DOWNLOAD_TIMEOUT_MS=180000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
SLOW_MO_MS=0
BROWSER_ARGS=
# Only needed when Chromium runs as root in a container.
BROWSER_NO_SANDBOX=false

# --- Report freshness ------------------------------------------------------
# The advertiser's reporting zone; Chromium runs in it.
REPORT_TIMEZONE=US/Pacific
# Warn when the newest date in a download is older than this: the console
# schedule has probably stopped.
REPORT_MAX_AGE_DAYS=3

# --- Retry -----------------------------------------------------------------
# Transient failures only. Auth/CAPTCHA/MFA are never retried.
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
RETRY_BACKOFF_MAX_SECONDS=120

# --- Logging and housekeeping ----------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
FILE_RETENTION_DAYS=30
# Keep a copy of each loaded report in PROCESSED_DIR (pruned after FILE_RETENTION_DAYS).
KEEP_PROCESSED_FILES=true
